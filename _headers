/**
 * @file Security response headers configuration for static hosting platforms that support a `_headers` file.
 *
 * @remarks
 * Production is served from GitHub Pages, which does not read this file, so none of it is served
 * to visitors (not emitted as headers). It is kept as a reference copy of the intended policy, and the decision to accept
 * that, with what is and is not covered and how to change it, is recorded in .github/SECURITY.md
 * under "Response headers" (#433).
 *
 * This file is only applied by compatible hosts (for example, Netlify and Cloudflare Pages). A
 * Cloudflare proxy in front of GitHub Pages does not apply it either; the same headers would have
 * to be recreated as Response Header Transform Rules in the Cloudflare dashboard.
 *
 * @warning
 * If hosting changes, or the headers are recreated elsewhere, update .github/SECURITY.md so the
 * two do not drift. The only policy actually enforced today is the <meta> CSP and <meta> referrer
 * tag in each page.
 */
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src https://www.instagram.com https://instagram.com; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://41kk82h2.apicdn.sanity.io https://41kk82h2.api.sanity.io https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cross-Origin-Resource-Policy: same-origin
*/

# Cache static assets for 1 day (long-lived but revalidated periodically)
/resources/css/*
  Cache-Control: public, max-age=86400

/resources/js/*
  Cache-Control: public, max-age=86400

/resources/images/*
  Cache-Control: public, max-age=86400

# Cache partials for 1 hour (these can change more often)
/partials/*
  Cache-Control: public, max-age=3600
